# ─────────────────────────────────────────────────────────────
#  Neon PostgreSQL connection string. Copy the pooled connection string from
#  Neon Console -> Connect, then replace this placeholder.
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require

# ─────────────────────────────────────────────────────────────
#  JWT Auth Settings
#  SECRET_KEY: run this to generate → python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────
SECRET_KEY=generate-a-strong-random-key-using-the-command-above
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
