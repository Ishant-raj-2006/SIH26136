{
  "compilerOptions": {
    "target": "ES2020",

    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],

    "module": "ESNext",
    "moduleResolution": "bundler",

    "jsx": "preserve",

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,

    "paths": {
      "@/*": [
        "./src/*"
      ]
    },

    "allowJs": true,

    "plugins": [
      {
        "name": "next"
      }
    ]
  },

  "include": [
    "src",
    ".next/types/**/*.ts"
  ],

  "exclude": [
    "node_modules"
  ]
}