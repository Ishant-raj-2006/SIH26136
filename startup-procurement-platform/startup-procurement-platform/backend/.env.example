# ─────────────────────────────────────────────────────────────
#  Neon PostgreSQL  →  Get your free DB at https://neon.tech
#  Copy the connection string from: Dashboard → Project → Connection Details
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require

# ─────────────────────────────────────────────────────────────
#  JWT Auth Settings
#  SECRET_KEY: run this to generate → python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────
SECRET_KEY=generate-a-strong-random-key-using-the-command-above
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
